# Hashes and shell scripts must keep their exact bytes.
#
# The repository lives on Windows, where Git's default autocrlf rewrites line
# endings on checkout. That is harmless for source and fatal for two things
# here: the recorded dependency hashes (the file is read back verbatim and
# compared) and the shell scripts (a CRLF shebang does not execute).
* text=auto eol=lf

# Recorded hashes are compared byte-for-byte.
core-native/src/main/cpp/third_party/.monocypher.sha256 -text
core-native/src/main/cpp/third_party/monocypher/** -text

# Shell scripts have to run on Linux and in CI.
*.sh text eol=lf

# Windows launchers are the exception: cmd.exe is happier with CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaries.
*.jar binary
*.png binary
*.apk binary
