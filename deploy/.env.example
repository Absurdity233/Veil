# Veil deployment settings.
#
# Copy to .env and edit:
#
#   cp .env.example .env
#
# This file is read by docker compose. Nothing in it is a secret: the relay holds
# no keys of its own, and the database stores only ciphertext.

# The name (or IP) this host answers on.
#
# With a DNS name and port 80 free, Caddy obtains a real certificate. Without
# either, the Caddyfile's `local_certs` line gives a self-signed one: the origin
# is still https://, which is a secure context, so the web client works after the
# browser's warning is accepted.
#
# This host, veil.example.com, has no DNS name and port 80 is already in use, so it
# runs in that second mode.
VEIL_DOMAIN=veil.example.com
