# Veil deployment settings.
#
# Copy to .env and edit:
#
#   cp .env.example .env
#
# This file is read by docker compose. Nothing in it is a secret: the relay holds
# no keys of its own, and the database stores only ciphertext.

# The DNS name this host answers on.
#
# Caddy needs a real name to obtain a certificate; an IP address alone cannot
# have one. Point an A record at the host before starting.
#
# For this server (veil.example.com) that means something like:
#
#   chat.example.com.  A  veil.example.com
#
# and then:
#
#   VEIL_DOMAIN=chat.example.com
VEIL_DOMAIN=veil.example.com
