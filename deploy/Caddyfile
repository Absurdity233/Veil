# Veil - TLS termination and static hosting.
#
# One origin serves both the page and the websocket, which is what keeps the
# browser's same-origin rules simple: no CORS, no cross-site cookie saga, and a
# content policy that can stay strict because every script comes from here.
#
# This deployment issues its own certificates from Caddy's internal CA.
#
# An IP address cannot have a public certificate - ACME only issues for names -
# and this host has no DNS name. A self-signed certificate still gives an
# https:// origin, which is what the web client needs: crypto.subtle requires a
# secure context, and https://<ip> is one even when no public CA vouches for it.
# The browser warns once; the client works after the warning is accepted.

{
	# An explicit default so Caddy does not try to be clever about which
	# interface to bind. In a container that is always :443 for this config.
	admin off
}

# The site, with the certificate loaded explicitly.
#
# Two things Caddy does not do on its own for a bare IP:
#
#   - It will not obtain a public certificate (ACME only issues for names), so
#     the issuer is the internal CA.
#   - An address-only site (`:443` with no host in the site key) gets no TLS
#     connection policy at all. The log says "listening only on the HTTPS port
#     but has no TLS connection policies", and every handshake fails with
#     `tlsv1 alert internal error` before any HTTP is seen - so the failure looks
#     like a broken certificate rather than a missing policy.
#
# `on_demand` makes Caddy issue and present a certificate for whatever SNI
# arrives, which is what an IP-only host needs: there is no name to pre-issue
# for, because the client connects to the address itself.
#
# The abuse warning Caddy logs for on-demand TLS is about a *public* deployment
# where anyone can request a certificate for any hostname. Here the internal CA
# only signs, nothing leaves the machine, and the certificate is refused by any
# browser that has not trusted this CA - so the warning does not apply.
:443 {
	tls internal {
		on_demand
	}

	@notThisHost not host {$VEIL_DOMAIN}
	respond @notThisHost 421

	# ---- Security headers ----
	#
	# The page is a self-contained application: it loads one script and one
	# wasm module from this origin and nothing else. Every relaxation below is
	# therefore a decision, not a default.
	header {
		# HSTS is only meaningful once a working certificate exists, which is
		# exactly when this file is in play.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		# No framing: a chat client inside somebody else's page is not a thing
		# this serves, and clickjacking a message-send button is.
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"

		# No third-party anything. 'wasm-unsafe-eval' is what allows the engine
		# module to instantiate; without it the client cannot start at all.
		# 'self' for script is strict on purpose - the threat model's weakest
		# point is script running on this origin.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'"

		# The relay never wants the page cached, but the assets are fine.
		-Server
	}

	# ---- The websocket ----
	#
	# A chat socket is long-lived and mostly idle. Caddy's defaults would be
	# fine, but being explicit documents what the deployment depends on.
	@ws {
		path /ws
	}
	handle @ws {
		reverse_proxy relay:8080 {
			# A websocket must not be killed for being quiet. The client sends
			# its own heartbeat through the protocol; an idle socket is normal.
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}

	# ---- Health, for an external monitor ----
	handle /health {
		reverse_proxy relay:8080
	}

	# ---- The web client ----
	handle {
		root * /srv
		encode zstd gzip

		# A short cache for the page, a long one for the bundle it pins. The
		# filenames are not content-hashed, so a long cache on app.js would
		# serve a stale client after an update.
		@immutable path /wasm/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		header Cache-Control "no-cache"
		file_server
	}

	log {
		output stdout
		format console
	}
}
